  "nodes": [
    {
      "id": "3ce626b7-6147-4877-a300-aae979f13aed",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1180,
        -720
      ],
      "parameters": {
        "width": 700,
        "height": 560,
        "color": 5,
        "content": "## RAG: Gemini + PostgreSQL (pgvector)\nคลังความรู้จากเอกสารของเรา ให้ AI ตอบโดยอ้างอิงเอกสารเท่านั้น\n\nคู่มือเต็ม: `workflows/rag-gemini-pgvector.md`\n\n### 1) นำเข้าเอกสาร (แถวบน)\nเปิด Form **Upload Document** → อัปโหลด PDF / DOCX / TXT / MD / CSV → แยกทีละไฟล์ → ตัดเป็น chunk (1000 ตัวอักษร, overlap 200) → สร้าง embedding ด้วย Gemini → เก็บลงตาราง `rag_documents`\n\n### 2) ถามตอบ (แถวล่าง)\nChat → **RAG Agent** เรียก tool `Knowledge_Base` ค้น chunk ที่ใกล้เคียงที่สุด 5 อัน แล้วให้ Gemini ตอบจากข้อมูลนั้น ประวัติแชทเก็บใน `rag_chat_histories`\n\n### ต้องรู้\n- Postgres ต้องมี pgvector: compose ใช้ image `pgvector/pgvector:pg18-trixie`\n- Embeddings **ทั้งสองตัว** ต้องใช้ model เดียวกัน (`gemini-embedding-001`, 3072 มิติ) ถ้าเปลี่ยน ต้องลบตารางแล้วนำเข้าใหม่\n- อัปโหลดไฟล์ชื่อเดิมซ้ำ = chunk ซ้ำ ลบของเก่าก่อน (SQL ในคู่มือ)\n- Form ไม่มีการยืนยันตัวตน ใครรู้ URL ก็เพิ่มเอกสารได้ อย่าเปิดสู่ภายนอก"
      }
    },
    {
      "id": "ef2b12e3-3a2c-4547-9068-63896b1c818f",
      "name": "Upload Document",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        -1140,
        -80
      ],
      "parameters": {
        "formTitle": "นำเข้าเอกสารเข้าคลังความรู้",
        "formDescription": "อัปโหลดไฟล์ PDF, DOCX, TXT, MD หรือ CSV ระบบจะตัดเป็นส่วนย่อย สร้าง embedding ด้วย Gemini และเก็บลง PostgreSQL",
        "formFields": {
          "values": [
            {
              "fieldLabel": "เอกสาร",
              "fieldName": "documents",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf,.docx,.txt,.md,.csv",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "rag-upload",
          "buttonLabel": "นำเข้า",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "นำเข้าเอกสารเรียบร้อยแล้ว ลองถามใน Chat ได้เลย"
            }
          }
        }
      },
      "webhookId": "9786c4c2-44c1-4c0d-871e-54d472300013"
    },
    {
      "id": "d1e3c5e4-9b3b-4fed-938b-c08998b56421",
      "name": "Split Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        -80
      ],
      "parameters": {
        "jsCode": "// One item per uploaded file with the binary under \"data\", so the\n// Default Data Loader can tag every chunk with its own file name.\nconst out = [];\nfor (const item of $input.all()) {\n  for (const [key, file] of Object.entries(item.binary ?? {})) {\n    out.push({\n      json: {\n        fileName: file.fileName ?? key,\n        mimeType: file.mimeType,\n        uploadedAt: new Date().toISOString(),\n      },\n      binary: { data: file },\n    });\n  }\n}\nreturn out;"
      },
      "notes": "Form file fields arrive as documents_0, documents_1, ... on one item. Splitting them lets the loader read a fixed key (data) and set source metadata per file."
    },
    {
      "id": "7e9dd7c2-a581-45f0-8f56-b8dfb8783416",
