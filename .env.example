# Copy to .env (Compose loads it automatically from this directory).
# Change POSTGRES_PASSWORD before using this anywhere other than localhost.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

GENERIC_TIMEZONE=Asia/Bangkok

# LINE Messaging API (used by the line-mcp bridge service).
# Channel access token (long-lived) from LINE Developers Console > Messaging API.
# Keep .env out of git - the token can message and broadcast as your OA.
LINE_CHANNEL_ACCESS_TOKEN=
